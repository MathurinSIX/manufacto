# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Square Checkout
# sandbox: each checkout calls CreatePaymentLink with the mapped catalog product;
#   Square shows a sandbox testing panel (normal). Test card: 4111 1111 1111 1111.
# production: catalog products use CreatePaymentLink. Every purchasable internal
#   product must be linked to a Square catalog variation in the admin Square tab.
SQUARE_ENVIRONMENT=sandbox
SQUARE_API_VERSION=2026-01-22
SQUARE_ACCESS_TOKEN=your-square-access-token
SQUARE_LOCATION_ID=your-square-location-id
SQUARE_WEBHOOK_URL=https://your-domain.com/api/square/webhook
SQUARE_WEBHOOK_SIGNATURE_KEY=your-square-webhook-signature-key
# Square app OAuth scopes needed: PAYMENTS_READ/WRITE (refunds on cancel), ORDERS_READ/WRITE,
# SUBSCRIPTIONS_READ/WRITE, CUSTOMERS_READ/WRITE. Webhook events: payment.created,
# payment.updated, subscription.created, customer.created, customer.updated
# Runs a full Square ↔ Supabase user reconciliation when the server starts (set to false to disable)
SQUARE_USER_SYNC_ON_STARTUP=true
# Imports completed Square credit pack payments from the last N days on startup (set to false to disable)
SQUARE_PURCHASE_SYNC_ON_STARTUP=true
SQUARE_PURCHASE_SYNC_DAYS=30

# Resend (class registration emails)
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=Manufacto <contact@manufacto-marseille.fr>
RESEND_REPLY_TO_EMAIL=contact@manufacto-marseille.fr
# Same-day booking alerts (falls back to contact@manufacto-marseille.fr)
ADMIN_NOTIFY_EMAIL=contact@manufacto-marseille.fr

# Vercel Cron auth for session reminder emails
CRON_SECRET=your-random-cron-secret

# PostHog (A/B experiments + analytics)
# Project API key from PostHog → Project settings. EU cloud host below; use https://us.i.posthog.com for US.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_your_project_token
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# When PostHog is unset/unreachable: test = today's retours (default), control = yesterday UI-v2
POSTHOG_EXPERIMENT_DEFAULT=test
# QA overrides (persisted in cookie mf_ph_exp across navigations):
#   ?ph_exp=control | ?ph_exp=test | ?ph_exp=exp-hero-headline:test
#   ?ph_exp=clear  — remove the override
# Running multivariate flags in PostHog (variants: control, test), 50/50:
#   exp-hero-headline      — control: “Un atelier pour faire, apprendre ou offrir”
#                            test: “Faire soi-même, réparer, réemployer, créer.”
#                            (falls back to control when the flag is missing)
#   exp-atelier-retours    — control: yesterday L'atelier · test: credits layout
#   exp-atelier-hero       — control: Marseille line · test: “quatre univers”
#   exp-atelier-tarifs     — control: no checkout buttons · test: Acheter and Souscrire
#   exp-pratique-inscrire  — control: offer cards as they are · test: S'inscrire on each offer
#   exp-calendar-images    — control: month cells without photos · test: day images
